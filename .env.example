# =============================================================================
# NEXUS — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values.
# Lines starting with # are comments. Do NOT commit .env to version control.
# =============================================================================

# ── App Settings ─────────────────────────────────────────────────────────────
APP_NAME=NEXUS
APP_ENV=development                     # development | staging | production
DEBUG=true
LOG_LEVEL=INFO                          # DEBUG | INFO | WARNING | ERROR

# ── Auth ─────────────────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-random-64-char-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Admin seed user ──────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@nexus.local
ADMIN_PASSWORD=changeme123

# ── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000"]  # JSON list of allowed origins

# ── PostgreSQL Database ──────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://nexus:nexus@localhost:5432/nexus_db

# ── Redis (cache + Celery broker) ────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── ChromaDB (vector store) ──────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8100
CHROMA_COLLECTION=nexus_vectors         # Name of the default Chroma collection

# ── File Storage ─────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads                    # Local directory for uploaded files
MAX_UPLOAD_SIZE_MB=50                   # Max single-file upload in megabytes

# ── LLM Provider Selection ──────────────────────────────────────────────
LLM_PROVIDER=groq
LLM_AUTO_FALLBACK=true

# Groq (Primary — Free)
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini (Secondary — Free)
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-1.5-flash

# Ollama (Tertiary — Local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi3:mini

# OpenAI (Optional)
OPENAI_API_KEY=sk-REPLACE_ME            # Your OpenAI API key
OPENAI_MODEL=gpt-4o-mini                # Model used for answer generation

# ── Embedding Model ─────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2       # SentenceTransformers model name

# ── Whisper (audio transcription) ────────────────────────────────────────────
WHISPER_MODEL_SIZE=base                 # tiny | base | small | medium | large
WHISPER_MODEL=base                      # canonical model name used by AudioExtractor
AUDIO_MAX_WORDS_PER_CHUNK=120           # target words per audio chunk
AUDIO_OVERLAP_WORDS=15                  # word overlap between consecutive audio chunks

# ── Celery Task Queue ───────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Embeddings & Vector Store ───────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_PERSIST_PATH=./chroma_data
DEFAULT_TOP_K=10
CLIP_MODEL=openai/clip-vit-base-patch32
TESSERACT_AVAILABLE=true
